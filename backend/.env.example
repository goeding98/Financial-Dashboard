# Copiar este archivo como .env y completar los valores reales.
# .env nunca se sube a git (ver .gitignore) — pedir las credenciales por un canal seguro.

# Credenciales de la API de Siigo (obligatorias)
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=

# Opcionales — valores por defecto ya funcionan en desarrollo local
SIIGO_PARTNER_ID=FinancialDashboard
SIIGO_BASE_URL=https://api.siigo.com
GOOGLE_SHEET_ID=1NN6D6hrqXwAlbbACVkA2U11s7LIvu3urZMCT4dZcvt0
PORT=3001

# Orígenes adicionales permitidos por CORS, separados por coma
# (localhost y *.vercel.app ya están permitidos siempre)
ALLOWED_ORIGINS=
